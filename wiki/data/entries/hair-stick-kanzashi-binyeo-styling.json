aticflickr.com/8489/8156465867_c154fda633_b.jpg","title":"Tsumami kanzashi basics tutorial","license":"BY-NC-SA 2.0","creator":"EruwaedhielElleth","page":"https://www.flickr.com/photos/63590738@N03/8156465867","source":"Flickr"},{"url":"https://api.openverse.org/v1/images/5e3323ad-e48c-4c53-9eea-18122227de75/thumb/","full":"https://live.staticflickr.com/4150/5042561104_8d9a886330_b.jpg","title":"Kanzashi ~ new life for old buttons","license":"BY-NC-ND 2.0","creator":"Rosa Say","page":"https://www.flickr.com/photos/26537801@N05/5042561104","source":"Flickr"},{"url":"https://api.openverse.org/v1/images/25c2b12c-e656-4f97-bae0-9cafd0d3c1c2/thumb/","full":"https://live.staticflickr.com/4085/5042552538_d54093b3af_b.jpg","title":"Kanzashi ~ blues","license":"BY-NC-ND 2.0","creator":"Rosa Say","page":"https://www.flickr.com/photos/26537801@N05/5042552538","source":"Flickr"}],"links":{"studies":[{"title":"Female intravesical foreign body penetrating the bladder wall: A rare case of traditional Asian hair stick <i>kanzashi</i>.","url":"https://pubmed.ncbi.nlm.nih.gov/37808582/","source":"Clinical case reports","year":2023,"cites":3,"kind":null}],"trials":[],"label":null,"reddit":[],"forums":[],"news":[],"social":[],"web":[{"title":"Hair stick / kanzashi / binyeo styling — Grokipedia","url":"https://grokipedia.com/page/Kanzashi"},{"title":"Kanzashi","url":"https://en.wikipedia.org/wiki/Kanzashi"},{"title":"Binyeo","url":"https://en.wikipedia.org/wiki/Binyeo"}]},"angle":{"goal":"Hair (scalp)","chain":["Pin secures a bun or topknot","Hair held in a defined shape","Neater, more ornamented hairstyle"],"effect":"direct","text":"A hair stick holds up long hair and adds decoration, giving a styled updo without elastics. Ornamented ends serve as accessories."},"wikipedia":null,"grokipedia":"https://grokipedia.com/page/Kanzashi","lead":["Kanzashi are traditional Japanese hair ornaments, a term covering hairpins, combs and fabric flowers; in English it usually refers to folded-silk tsumami kanzashi.[1] Binyeo are traditional Korean hairpins used to fix women's chignons and also served as decoration.[2]","Both are used to secure upswept hair and to adorn it. Binyeo marked a married woman and could signal social status; kanzashi use expanded as Edo-period hairstyles grew more elaborate.[1][2]","Today kanzashi appear mainly with geisha, maiko, brides and re-enactors, with ordinary hair clips common; tsumami kanzashi were designated a traditional Tokyo craft in 1982.[1]"],"infobox":[["Japan","Kanzashi"],["Korea","Binyeo (jam, chae types)"],["Materials","Lacquered wood, metal, tortoiseshell, silk, plastic"],["Craft status","Tsumami kanzashi: traditional Tokyo craft (1982)"]],"sections":[{"h":"Kanzashi","paras":["Kanzashi date to the Jomon period; Chinese hairpins (zan) arrived in the Nara period, kanzashi became a general word for hair ornaments in the Heian period, and Edo-period craftsmanship peaked late.[1] Types include hairpins such as bira-bira, combs (kushi), and tsumami flowers arranged seasonally.[1]"],"subs":[]},{"h":"Binyeo","paras":["Binyeo trace to the Three Kingdoms era. In Silla, a ban on the wig gache led to binyeo replacing it; Joseon rules restricted gold and silver. They were worn at gyerye coming-of-age, and wooden ones for mourning. Types are the long jam and the U-shaped chae.[2]"],"subs":[]},{"h":"Clinical studies","paras":["No studies found. A 2023 case report describes a hair stick being inserted into a bladder, an unrelated misuse of the object.[3]"],"subs":[]}],"lore":null,"timeline":[{"year":"1982","event":"Tsumami kanzashi designated a traditional Tokyo craft.[1]"}],"refs":[{"title":"Kanzashi","url":"https://en.wikipedia.org/wiki/Kanzashi","source":"Wikipedia","year":2025,"type":"encyclopedia"},{"title":"Binyeo","url":"https://en.wikipedia.org/wiki/Binyeo","source":"Wikipedia","year":2025,"type":"encyclopedia"},{"title":"Female intravesical foreign body penetrating the bladder wall: kanzashi","url":"https://pubmed.ncbi.nlm.nih.gov/37808582/","source":"Clinical Case Reports","year":2023,"type":"study"}],"studies":[{"title":"Female intravesical foreign body penetrating the bladder wall: kanzashi","url":"https://pubmed.ncbi.nlm.nih.gov/37808582/","source":"Clinical Case Reports","year":2023,"kind":null}],"reddit":[],"forums":[]}