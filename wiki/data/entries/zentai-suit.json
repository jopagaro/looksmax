ginal","title":"Gold flower patterned Zentai and Iris","license":"CC BY-SA 3.0","creator":"\"Marcy_Anarchy\"","page":"https://commons.wikimedia.org/wiki/File:Gold_flower_patterned_Zentai_and_Iris.jpg","source":"Wikimedia Commons"},{"url":"https://api.openverse.org/v1/images/4775a5ce-b3ad-49e1-b8df-be7270035788/thumb/","full":"https://live.staticflickr.com/7243/7267684250_13e10c9176_b.jpg","title":"Zentai Suit - D7K 9427 ep","license":"BY-NC 2.0","creator":"Eric.Parker","page":"https://www.flickr.com/photos/13484951@N00/7267684250","source":"Flickr"}],"links":{"studies":[{"title":"Optically active N-acetyldopamine dimer of the crude drug \"Zentai,\" the cast-off shell of the Cicada, Cryptotympana sp.","url":"https://pubmed.ncbi.nlm.nih.gov/11086906/","source":"Chemical & pharmaceutical bulletin","year":2000,"cites":30,"kind":null},{"title":"Influence of genotype and explant source on the in vitro regeneration ability of different melon varieties.","url":"https://pubmed.ncbi.nlm.nih.gov/21112840/","source":"Acta biologica Hungarica","year":2010,"cites":0,"kind":null}],"trials":[],"label":null,"reddit":[],"forums":[{"title":"Jordan 2, ISIS/L 1","url":"https://t-nation.com/t/jordan-2-isis-l-1/206797","site":"T Nation · 1129 posts · 2015"},{"title":"Going Banana's in '09","url":"https://t-nation.com/t/going-bananas-in-09/120294","site":"T Nation · 460 posts · 2009"},{"title":"Colucci Still Lifts","url":"https://t-nation.com/t/colucci-still-lifts/235722","site":"T Nation · 409 posts · 2017"}],"news":[],"social":[],"web":[{"title":"Zentai suit — Grokipedia","url":"https://grokipedia.com/page/Zentai"},{"title":"Zentai","url":"https://en.wikipedia.org/wiki/Zentai"}]},"angle":{"goal":"Style & presentation","chain":["Full-body stretch suit covers face and body","Individual features are hidden","Uniform look for costume, performance or anonymity"],"effect":"direct","text":"A zentai works by concealment: it removes visible facial and body features, which wearers use for costumes and for relief from self-consciousness."},"wikipedia":null,"grokipedia":"https://grokipedia.com/page/Zentai","lead":["A zentai suit is a skin-tight garment covering the entire body including head, hands and feet, typically made of nylon or spandex blends. The word is short for the Japanese zenshin taitsu (全身タイツ).[1][2]","Instead of improving a wearer's features, it conceals them. Wearers describe it as a way to become anonymous, to escape social pressure about appearance, or to perform as a character.[2]","No clinical research addresses zentai."],"infobox":[["Type","Full-body stretch suit"],["Material","Nylon/spandex (lycra)"],["Name origin","Zenshin taitsu, Japanese"],["Brands","Morphsuits, Second Skins, RootSuit, Bodysocks"]],"sections":[{"h":"Uses","paras":["Documented uses include sports fans (the Vancouver Canucks 'Green Men'), street-dance groups, chroma-key video work where the solid colour is digitally removed, music videos, fashion, public art and social-anxiety workshops.[1]","In Japan, some wearers describe using zentai to reduce pressure about personal appearance by obscuring features.[2]"],"subs":[]},{"h":"Rules and culture","paras":["France may fine wearers up to 150 euros for face-covering in public, and some sports leagues ban the hoods.[1] The suits are also associated by some with fetish communities, though wearers and event organisers describe broader artistic and costume use.[2]"],"subs":[]},{"h":"Clinical studies","paras":["No studies found."],"subs":[]}],"lore":null,"timeline":[],"refs":[{"title":"Zentai","url":"https://en.wikipedia.org/wiki/Zentai","source":"Wikipedia","year":2025,"type":"encyclopedia"},{"title":"Zentai","url":"https://grokipedia.com/page/Zentai","source":"Grokipedia","year":2025,"type":"encyclopedia"}],"studies":[],"reddit":[],"forums":[{"title":"Jordan 2, ISIS/L 1","url":"https://t-nation.com/t/jordan-2-isis-l-1/206797","site":"T Nation · 1129 posts · 2015"},{"title":"Going Banana's in '09","url":"https://t-nation.com/t/going-bananas-in-09/120294","site":"T Nation · 460 posts · 2009"},{"title":"Colucci Still Lifts","url":"https://t-nation.com/t/colucci-still-lifts/235722","site":"T Nation · 409 posts · 2017"}]}