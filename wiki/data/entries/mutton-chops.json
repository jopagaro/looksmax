":null}],"trials":[],"label":null,"reddit":[],"forums":[{"title":"Going Bananas","url":"https://t-nation.com/t/going-bananas/143468","site":"T Nation · 1126 posts · 2010"},{"title":"Catholic Q & A","url":"https://t-nation.com/t/catholic-q-a/158641","site":"T Nation · 1125 posts · 2010"},{"title":"Ask Moshe","url":"https://t-nation.com/t/ask-moshe/177296","site":"T Nation · 759 posts · 2012"},{"title":"2-SCOOPS Training Log","url":"https://t-nation.com/t/2-scoops-training-log/139105","site":"T Nation · 757 posts · 2009"},{"title":"Just Make It Fast, Loud and Rude. Rattlehead.","url":"https://t-nation.com/t/just-make-it-fast-loud-and-rude-rattlehead/191779","site":"T Nation · 646 posts · 2013"},{"title":"Eighty to 100 Pound Muscular Gains","url":"https://t-nation.com/t/eighty-to-100-pound-muscular-gains/188573","site":"T Nation · 419 posts · 2013"},{"title":"Official Mustache Thread","url":"https://t-nation.com/t/official-mustache-thread/153250","site":"T Nation · 383 posts · 2010"},{"title":"JLD2k3's 5-3-1","url":"https://t-nation.com/t/jld2k3s-5-3-1/148459","site":"T Nation · 372 posts · 2010"},{"title":"21 Y/O Male - Advice Needed","url":"https://t-nation.com/t/21-y-o-male-advice-needed/211810","site":"T Nation · 372 posts · 2015"},{"title":"Beard Power","url":"https://t-nation.com/t/beard-power/160776","site":"T Nation · 352 posts · 2011"},{"title":"Why Does Alpha Destiny Get Such Hate on Forums?","url":"https://t-nation.com/t/why-does-alpha-destiny-get-such-hate-on-forums/233804","site":"T Nation · 209 posts · 2017"},{"title":"Guess My Race","url":"https://t-nation.com/t/guess-my-race/67094","site":"T Nation · 161 posts · 2006"},{"title":"Superman...Metropolis-Sexual?","url":"https://t-nation.com/t/superman-metropolis-sexual/48330","site":"T Nation · 121 posts · 2005"},{"title":"Results After 2.5 Years WALRUS Training","url":"https://t-nation.com/t/results-after-2-5-years-walrus-training/277100","site":"T Nation · 104 posts · 2022"},{"title":"Ryan Sharp 17 Yr Old","url":"https://t-nation.com/t/ryan-sharp-17-yr-old/240293","site":"T Nation · 90 posts · 2018"}],"news":[],"social":[],"web":[{"title":"Sideburns - Wikipedia","url":"https://en.wikipedia.org/wiki/Sideburns"}]},"angle":{"goal":"Jawline & face shape","chain":["Grow sideburns long and full","Cheeks and jaw are framed","Distinctive, broader-looking lower face"],"effect":"direct","text":"The hair itself creates the outline: width along the jaw and cheeks, with or without a joined moustache. People pick it as a distinctive alternative to a full beard."},"wikipedia":null,"grokipedia":null,"lead":["Mutton chops are a facial-hair style in which sideburns run long and full along the cheeks. 'Friendly mutton chops' connect the sideburns to a moustache while leaving the chin clean-shaven [1].","The name 'sideburns' is said to come from 'burnsides', after Ambrose Burnside, a Civil War general who wore thick sideburns joined to a moustache. Nineteenth-century versions were often more extravagant than modern ones, and Elvis Presley helped spur a 1950s revival among rockers and greasers. They became common across many groups in the 1970s [1].","In appearance terms the style frames the face, widens the lower face visually and adds a distinctive outline. Wikipedia notes it can read as old-fashioned, rough, rebellious or retro [1]. No research on the style's effect on perceived attractiveness was identified."],"infobox":[["Type","Facial hair style"],["Variant","Friendly mutton chops (joined to moustache)"],["Named after","Ambrose Burnside (sideburns)"],["Maintenance","Regular trimming and chin/neck shaving"]],"sections":[{"h":"Description","paras":["Mutton chops leave the chin shaved and grow the sideburns long, often to the jawline or beyond; when joined with a moustache they are called friendly mutton chops [1]."],"subs":[]},{"h":"History","paras":["Sideburns are named after Ambrose Burnside. Victorian-era styles hung well below the jaw, a mid-1950s revival followed Elvis Presley, and the 1970s made them widespread. 'Lambchop' sideburns were a symbol in some gay club scenes in San Francisco and Sydney, and musicians such as Neil Young and Lemmy are associated with them [1]."],"subs":[]},{"h":"Clinical studies","paras":["No studies found."],"subs":[]}],"lore":null,"timeline":[{"year":"1860s","event":"Ambrose Burnside's whiskers give sideburns their name [1]."},{"year":"1950s","event":"Revival among rockers and greasers following Elvis Presley [1]."},{"year":"1970s","event":"Sideburns become common across many groups [1]."}],"refs":[{"title":"Sideburns","url":"https://en.wikipedia.org/wiki/Sideburns","source":"Wikipedia","year":null,"type":"encyclopedia"}],"studies":[],"reddit":[],"forums":[{"title":"Going Bananas","url":"https://t-nation.com/t/going-bananas/143468","site":"T Nation · 1126 posts · 2010"},{"title":"Catholic Q & A","url":"https://t-nation.com/t/catholic-q-a/158641","site":"T Nation · 1125 posts · 2010"},{"title":"Ask Moshe","url":"https://t-nation.com/t/ask-moshe/177296","site":"T Nation · 759 posts · 2012"},{"title":"2-SCOOPS Training Log","url":"https://t-nation.com/t/2-scoops-training-log/139105","site":"T Nation · 757 posts · 2009"},{"title":"Just Make It Fast, Loud and Rude. Rattlehead.","url":"https://t-nation.com/t/just-make-it-fast-loud-and-rude-rattlehead/191779","site":"T Nation · 646 posts · 2013"},{"title":"Eighty to 100 Pound Muscular Gains","url":"https://t-nation.com/t/eighty-to-100-pound-muscular-gains/188573","site":"T Nation · 419 posts · 2013"}]}