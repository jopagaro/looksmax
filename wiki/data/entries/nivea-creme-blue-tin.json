y open science","year":2025,"cites":2,"kind":null},{"title":"An asymptotic slender-body model for predicting print resolution in extrusion-based bioprinting.","url":"https://pubmed.ncbi.nlm.nih.gov/42597374/","source":"Journal of engineering mathematics","year":2026,"cites":0,"kind":null}],"trials":[],"label":null,"reddit":[],"forums":[{"title":"Dry Skin","url":"https://t-nation.com/t/dry-skin/30525","site":"T Nation · 14 posts · 2003"}],"news":[],"social":[],"web":[{"title":"Nivea","url":"https://en.wikipedia.org/wiki/Nivea"}]},"angle":{"goal":"Skin","chain":["Occlusive cream applied to skin","Holds moisture in","Softer, smoother-looking skin"],"effect":"direct","text":"It moisturises dry skin on the face, hands and body, which leaves skin looking smoother. Users apply it as a basic everyday cream."},"wikipedia":null,"grokipedia":null,"lead":["Nivea Creme is a moisturising cream from the German company Beiersdorf, introduced in 1911 and described as the first stable water-in-oil emulsion.[1] It is sold in a blue tin with a white logo adopted in 1925.[1]","People use it to keep dry skin soft and smooth, such as on arms and shoulders in winter, as a T Nation poster described in 2003.[2]","The cream relies on Eucerit, a lanolin-based emulsifier patented in 1900 by Isaac Lifschutz, which Oscar Troplowitz and dermatologist Paul Gerson Unna helped bring into the product.[1] No published trial has tested the tin product itself."],"infobox":[["Type","Water-in-oil moisturising cream"],["Maker","Beiersdorf"],["Launched","1911[1]"],["Blue tin","1925[1]"],["Key ingredient","Eucerit (lanolin-based emulsifier)[1]"]],"sections":[{"h":"History","paras":["Paul Beiersdorf founded the company in 1882 and pharmacist Oscar Troplowitz took over in 1890.[1] Nivea soap came in 1906 and Nivea Creme in 1911.[1] The cream was relaunched in the blue tin in 1925.[1]"],"subs":[]},{"h":"Use","paras":["Forum users describe it as a post-shower moisturiser for dry patches, in one case alongside a hand cream for cracking skin.[2]"],"subs":[]},{"h":"Clinical studies","paras":["No studies found."],"subs":[]}],"lore":null,"timeline":[{"year":"1900","event":"Eucerit emulsifier patented.[1]"},{"year":"1911","event":"Nivea Creme launched.[1]"},{"year":"1925","event":"Blue tin introduced.[1]"}],"refs":[{"title":"Nivea","url":"https://en.wikipedia.org/wiki/Nivea","source":"Wikipedia","year":2026,"type":"encyclopedia"},{"title":"Dry Skin","url":"https://t-nation.com/t/dry-skin/30525","source":"T Nation forum","year":2003,"type":"forum"}],"studies":[],"reddit":[],"forums":[{"title":"Dry Skin","url":"https://t-nation.com/t/dry-skin/30525","site":"T Nation · 14 posts · 2003"}]}